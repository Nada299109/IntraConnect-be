# ──────────────────────────────────────────
# IntraConnect Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────

# ── App ───────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (PostgreSQL) ─────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/intraconnect"

# ── Auth / JWT ────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(48, (e,b)=>console.log(b.toString('hex')))"
JWT_SECRET=change-me-to-a-random-hex-string

# ── Password Policy ───────────────────────
PWD_MIN_LENGTH=8
PWD_REQUIRE_UPPER=true
PWD_REQUIRE_LOWER=true
PWD_REQUIRE_DIGIT=true
PWD_REQUIRE_SYMBOL=false

# ── Account Lockout ───────────────────────
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── CORS ──────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── SMTP (email / OTP) ────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="IntraConnect <no-reply@example.com>"

# ── S3 / MinIO (file storage) ─────────────
# For local dev, run MinIO: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=intraconnect
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=300
